#!/usr/bin/env python3
"""Zaod OS local launcher service. Serves the white Zaod home page and
launches allow-listed local apps on behalf of that page. Bound to loopback."""
import json
import os
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 8765
HOME_PAGE = "/usr/local/share/zaod/home/index.html"

APPS = {
    "files": ["thunar"],
    "camera": ["guvcview"],
    "settings": ["xfce4-settings-manager"],
    "terminal": ["xfce4-terminal"],
    "wifi": ["nm-connection-editor"],
    "bluetooth": ["blueman-manager"],
    "browser": ["chromium", "--no-first-run"],
}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _send(self, code, body, ctype="text/plain; charset=utf-8"):
        data = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            try:
                with open(HOME_PAGE, "r", encoding="utf-8") as fh:
                    self._send(200, fh.read(), "text/html; charset=utf-8")
            except OSError as exc:
                self._send(500, f"home page missing: {exc}")
        elif self.path == "/health":
            self._send(200, "ok")
        else:
            self._send(404, "not found")

    def do_POST(self):
        if not self.path.startswith("/api/launch"):
            return self._send(404, "not found")
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b"{}"
        try:
            app = (json.loads(raw or b"{}") or {}).get("app", "")
        except Exception:
            return self._send(400, "bad json")
        cmd = APPS.get(app)
        if not cmd:
            return self._send(400, "unknown app")
        try:
            subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                env=dict(os.environ, DISPLAY=os.environ.get("DISPLAY", ":0")),
            )
        except Exception as exc:
            return self._send(500, str(exc))
        self._send(200, "launched")


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
